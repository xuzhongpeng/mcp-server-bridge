{
  "name": "mcp-server-bridge",
  "version": "1.0.0",
  "description": "MCP服务器管理工具",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "preview": "electron-vite preview",
    "tsc": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:mcpHost": "jest src/main/mcpHost/__tests__"
  },
  "keywords": [
    "electron",
    "react",
    "mcp",
    "server",
    "bridge"
  ],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.example.mcp-server-bridge",
    "productName": "MCP Server Bridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-loader": "^9.1.3",
    "concurrently": "^9.1.2",
    "copy-webpack-plugin": "^13.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.10.0",
    "electron": "^29.1.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.1.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "style-loader": "^3.3.4",
    "ts-jest": "^29.3.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "vite": "^6.2.5",
    "wait-on": "^7.2.0",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.2"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@modelcontextprotocol/sdk": "^1.8.0",
    "antd": "^5.24.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.4.1"
  }
}
